{
  "name": "nos-spec-ui",
  "private": true,
  "version": "0.1.0",
  "description": "Read-only viewer for the specs root of the nos harness",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev-to-lan": "vite --host --mode lan",
    "build": "vite build -c vite.standalone.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.9",
    "qrcode-generator": "^2.0.4",
    "selfsigned": "^5.5.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  }
}
